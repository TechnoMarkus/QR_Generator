<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>QR Code Studio - Custom QR Generator</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontAwesome for icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Google Fonts Inter -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <!-- QRCode Styling Library CDN for Canvas and SVG support with customization -->
  <script src="https://cdn.jsdelivr.net/npm/qr-code-styling@1.5.0/lib/qr-code-styling.js"></script>
  <style>
    body {
      font-family: 'Inter', sans-serif;
    }
    /* Custom scrollbar for smooth visual appeal */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #f1f5f9;
    }
    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col justify-between">

  <!-- Header -->
  <header class="bg-white border-b border-slate-200 sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <div class="bg-indigo-600 text-white p-2 rounded-xl shadow-md">
          <i class="fa-solid fa-qrcode text-xl"></i>
        </div>
        <span class="text-xl font-bold bg-gradient-to-r from-indigo-600 to-violet-600 bg-clip-text text-transparent">
          QR Studio
        </span>
      </div>
      <div class="text-xs sm:text-sm text-slate-500 font-medium">
        Fast, Free & Client-Side
      </div>
    </div>
  </header>

  <!-- Main Content Container -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-grow w-full">
    
    <!-- Notification Toast -->
    <div id="toast" class="fixed bottom-5 right-5 transform translate-y-20 opacity-0 transition-all duration-300 ease-in-out bg-slate-900 text-white px-5 py-3 rounded-xl shadow-2xl flex items-center space-x-3 z-50">
      <i id="toast-icon" class="fa-solid fa-circle-check text-emerald-400"></i>
      <span id="toast-message" class="text-sm font-medium">Action completed!</span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">

      <!-- Left Column: Controls and Inputs -->
      <div class="lg:col-span-7 space-y-6">
        
        <!-- Type Selection Tabs -->
        <div class="bg-white rounded-2xl p-4 border border-slate-200/80 shadow-sm">
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3">Content Type</label>
          <div class="grid grid-cols-3 sm:grid-cols-5 gap-2" id="type-tabs">
            <button data-type="url" class="tab-btn flex flex-col items-center justify-center p-3 rounded-xl text-xs font-medium border transition-all bg-indigo-50 border-indigo-200 text-indigo-600">
              <i class="fa-solid fa-link text-lg mb-1.5"></i>
              URL
            </button>
            <button data-type="text" class="tab-btn flex flex-col items-center justify-center p-3 rounded-xl text-xs font-medium border border-slate-200 hover:border-slate-300 text-slate-600">
              <i class="fa-solid fa-align-left text-lg mb-1.5"></i>
              Text
            </button>
            <button data-type="wifi" class="tab-btn flex flex-col items-center justify-center p-3 rounded-xl text-xs font-medium border border-slate-200 hover:border-slate-300 text-slate-600">
              <i class="fa-solid fa-wifi text-lg mb-1.5"></i>
              Wi-Fi
            </button>
            <button data-type="email" class="tab-btn flex flex-col items-center justify-center p-3 rounded-xl text-xs font-medium border border-slate-200 hover:border-slate-300 text-slate-600">
              <i class="fa-solid fa-envelope text-lg mb-1.5"></i>
              Email
            </button>
            <button data-type="phone" class="tab-btn flex flex-col items-center justify-center p-3 rounded-xl text-xs font-medium border border-slate-200 hover:border-slate-300 text-slate-600">
              <i class="fa-solid fa-phone text-lg mb-1.5"></i>
              Phone
            </button>
          </div>
        </div>

        <!-- Input Dynamic Fields Card -->
        <div class="bg-white rounded-2xl p-6 border border-slate-200/80 shadow-sm space-y-4">
          <h2 class="text-lg font-semibold text-slate-800 border-b border-slate-100 pb-3 flex items-center gap-2">
            <i class="fa-solid fa-pen-to-square text-indigo-500"></i>
            Input Information
          </h2>

          <!-- URL Input -->
          <div id="field-url" class="input-field-group">
            <label class="block text-sm font-medium text-slate-700 mb-1">Website URL</label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                <i class="fa-solid fa-globe"></i>
              </span>
              <input type="url" id="input-url-value" placeholder="https://example.com" value="https://example.com" class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm">
            </div>
          </div>

          <!-- Text Input -->
          <div id="field-text" class="input-field-group hidden">
            <label class="block text-sm font-medium text-slate-700 mb-1">Plain Text</label>
            <textarea id="input-text-value" rows="3" placeholder="Enter your text or note here..." class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm">Hello, World!</textarea>
          </div>

          <!-- Wi-Fi Inputs -->
          <div id="field-wifi" class="input-field-group hidden space-y-3">
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Network Name (SSID)</label>
              <input type="text" id="input-wifi-ssid" placeholder="Home WiFi" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm">
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Password</label>
              <input type="password" id="input-wifi-password" placeholder="••••••••" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm">
            </div>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Encryption</label>
                <select id="input-wifi-type" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm bg-white">
                  <option value="WPA">WPA/WPA2/WPA3</option>
                  <option value="WEP">WEP</option>
                  <option value="nopass">None (Open)</option>
                </select>
              </div>
              <div class="flex items-center pt-6">
                <label class="inline-flex items-center cursor-pointer">
                  <input type="checkbox" id="input-wifi-hidden" class="sr-only peer">
                  <div class="w-9 h-5 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-indigo-600 relative"></div>
                  <span class="ml-2 text-sm text-slate-600 font-medium">Hidden SSID</span>
                </label>
              </div>
            </div>
          </div>

          <!-- Email Input -->
          <div id="field-email" class="input-field-group hidden space-y-3">
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Recipient Email</label>
              <input type="email" id="input-email-address" placeholder="name@example.com" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm">
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Subject</label>
              <input type="text" id="input-email-subject" placeholder="Inquiry regarding..." class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm">
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Body</label>
              <textarea id="input-email-body" rows="2" placeholder="Write message..." class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm"></textarea>
            </div>
          </div>

          <!-- Phone Input -->
          <div id="field-phone" class="input-field-group hidden">
            <label class="block text-sm font-medium text-slate-700 mb-1">Phone Number</label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                <i class="fa-solid fa-phone"></i>
              </span>
              <input type="tel" id="input-phone-number" placeholder="+1 (555) 000-0000" class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm">
            </div>
          </div>

        </div>

        <!-- Customization Settings Card -->
        <div class="bg-white rounded-2xl p-6 border border-slate-200/80 shadow-sm space-y-5">
          <h2 class="text-lg font-semibold text-slate-800 border-b border-slate-100 pb-3 flex items-center gap-2">
            <i class="fa-solid fa-palette text-indigo-500"></i>
            Appearance & Style
          </h2>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <!-- Colors -->
            <div>
              <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Foreground Color</label>
              <div class="flex items-center space-x-3">
                <input type="color" id="fg-color" value="#1e293b" class="h-10 w-12 rounded-lg cursor-pointer border border-slate-200 bg-transparent p-1">
                <input type="text" id="fg-color-hex" value="#1e293b" class="uppercase text-xs font-mono w-24 px-3 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-1 focus:ring-indigo-500">
              </div>
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Background Color</label>
              <div class="flex items-center space-x-3">
                <input type="color" id="bg-color" value="#ffffff" class="h-10 w-12 rounded-lg cursor-pointer border border-slate-200 bg-transparent p-1">
                <input type="text" id="bg-color-hex" value="#ffffff" class="uppercase text-xs font-mono w-24 px-3 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-1 focus:ring-indigo-500">
              </div>
            </div>
          </div>

          <!-- Size & Margin Slider -->
          <div class="space-y-4 pt-2">
            <div>
              <div class="flex justify-between items-center mb-1">
                <label class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Dimension Output Size</label>
                <span id="size-label" class="text-xs font-mono text-indigo-600 font-semibold">300 x 300 px</span>
              </div>
              <input type="range" id="qr-size" min="150" max="800" step="10" value="300" class="w-full accent-indigo-600 bg-slate-100 h-2 rounded-lg cursor-pointer">
            </div>

            <div>
              <div class="flex justify-between items-center mb-1">
                <label class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Margin (Quiet Zone)</label>
                <span id="margin-label" class="text-xs font-mono text-indigo-600 font-semibold">10 px</span>
              </div>
              <input type="range" id="qr-margin" min="0" max="40" step="2" value="10" class="w-full accent-indigo-600 bg-slate-100 h-2 rounded-lg cursor-pointer">
            </div>
          </div>

          <!-- Style Patterns -->
          <div class="grid grid-cols-2 gap-4 pt-2">
            <div>
              <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Dot Pattern Style</label>
              <select id="dots-style" class="w-full px-3 py-2 rounded-lg border border-slate-200 text-xs font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-white">
                <option value="square">Squares (Classic)</option>
                <option value="dots">Dots</option>
                <option value="rounded" selected>Rounded</option>
                <option value="extra-rounded">Extra Rounded</option>
                <option value="classy">Classy</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Corner Square Style</label>
              <select id="corners-style" class="w-full px-3 py-2 rounded-lg border border-slate-200 text-xs font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-white">
                <option value="square">Square</option>
                <option value="dot">Dot</option>
                <option value="extra-rounded" selected>Extra Rounded</option>
              </select>
            </div>
          </div>

        </div>

      </div>

      <!-- Right Column: Preview & Download Card -->
      <div class="lg:col-span-5">
        <div class="bg-white rounded-2xl p-6 border border-slate-200/80 shadow-lg sticky top-24 flex flex-col items-center justify-between text-center space-y-6">
          
          <div class="w-full flex items-center justify-between border-b border-slate-100 pb-3">
            <span class="text-sm font-semibold text-slate-700 flex items-center gap-2">
              <i class="fa-solid fa-eye text-indigo-500"></i>
              Live Preview
            </span>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-100 text-emerald-800">
              Auto Updating
            </span>
          </div>

          <!-- QR Code Container Display Area -->
          <div class="relative p-6 bg-slate-100 rounded-xl border border-dashed border-slate-300 w-full flex items-center justify-center min-h-[320px] overflow-hidden" id="qr-wrapper">
            <div id="qr-code-canvas" class="flex justify-center items-center shadow-md rounded-lg overflow-hidden bg-white p-2"></div>
          </div>

          <!-- Download Options -->
          <div class="w-full space-y-3">
            <div class="grid grid-cols-2 gap-3">
              <button id="download-png" class="flex items-center justify-center space-x-2 bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white font-medium py-3 px-4 rounded-xl shadow-md transition-all text-sm">
                <i class="fa-solid fa-download"></i>
                <span>PNG</span>
              </button>
              <button id="download-svg" class="flex items-center justify-center space-x-2 bg-slate-800 hover:bg-slate-900 active:bg-black text-white font-medium py-3 px-4 rounded-xl shadow-md transition-all text-sm">
                <i class="fa-solid fa-file-code"></i>
                <span>SVG</span>
              </button>
            </div>

            <button id="copy-clipboard" class="w-full flex items-center justify-center space-x-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium py-2.5 px-4 rounded-xl transition-all text-xs">
              <i class="fa-solid fa-copy"></i>
              <span>Copy Data Payload</span>
            </button>
          </div>

        </div>
      </div>

    </div>

  </main>

  <!-- Footer -->
  <footer class="bg-white border-t border-slate-200 py-4 mt-8">
    <div class="max-w-7xl mx-auto px-4 text-center text-xs text-slate-500">
      &copy; QR Code Generator Studio. All code is rendered safely client-side in your browser.
    </div>
  </footer>

  <!-- Application Logic -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // Current active type state
      let activeType = 'url';

      <!-- Initialize QRCodeStyling Instance -->
      const qrCode = new QRCodeStyling({
        width: 300,
        height: 300,
        type: "canvas",
        data: "https://example.com",
        margin: 10,
        qrOptions: {
          typeNumber: 0,
          mode: "Byte",
          errorCorrectionLevel: "Q"
        },
        dotsOptions: {
          color: "#1e293b",
          type: "rounded"
        },
        backgroundOptions: {
          color: "#ffffff"
        },
        cornersSquareOptions: {
          color: "#1e293b",
          type: "extra-rounded"
        }
      });

      // Mount QR code canvas inside wrapper
      const qrContainer = document.getElementById('qr-code-canvas');
      qrCode.append(qrContainer);

      // Toast Notification Helper
      function showToast(message, isError = false) {
        const toast = document.getElementById('toast');
        const toastMsg = document.getElementById('toast-message');
        const toastIcon = document.getElementById('toast-icon');

        toastMsg.textContent = message;
        if (isError) {
          toastIcon.className = "fa-solid fa-circle-exclamation text-rose-400";
        } else {
          toastIcon.className = "fa-solid fa-circle-check text-emerald-400";
        }

        toast.classList.remove('translate-y-20', 'opacity-0');
        toast.classList.add('translate-y-0', 'opacity-100');

        setTimeout(() => {
          toast.classList.remove('translate-y-0', 'opacity-100');
          toast.classList.add('translate-y-20', 'opacity-0');
        }, 3000);
      }

      // Generate the raw text payload according to active tab
      function getPayload() {
        switch (activeType) {
          case 'url':
            const urlVal = document.getElementById('input-url-value').value.trim();
            return urlVal || 'https://example.com';

          case 'text':
            const textVal = document.getElementById('input-text-value').value.trim();
            return textVal || 'Hello, World!';

          case 'wifi':
            const ssid = document.getElementById('input-wifi-ssid').value.trim();
            const pass = document.getElementById('input-wifi-password').value.trim();
            const type = document.getElementById('input-wifi-type').value;
            const hidden = document.getElementById('input-wifi-hidden').checked;
            return `WIFI:S:${ssid};T:${type};P:${pass};H:${hidden ? 'true' : 'false'};;`;

          case 'email':
            const email = document.getElementById('input-email-address').value.trim();
            const subject = encodeURIComponent(document.getElementById('input-email-subject').value.trim());
            const body = encodeURIComponent(document.getElementById('input-email-body').value.trim());
            return `mailto:${email}?subject=${subject}&body=${body}`;

          case 'phone':
            const phone = document.getElementById('input-phone-number').value.trim();
            return `tel:${phone}`;

          default:
            return 'https://example.com';
        }
      }

      // Main Update function to refresh QR code view
      function updateQRCode() {
        const payload = getPayload();
        const fgColor = document.getElementById('fg-color').value;
        const bgColor = document.getElementById('bg-color').value;
        const sizeVal = parseInt(document.getElementById('qr-size').value, 10);
        const marginVal = parseInt(document.getElementById('qr-margin').value, 10);
        const dotsStyle = document.getElementById('dots-style').value;
        const cornersStyle = document.getElementById('corners-style').value;

        // Sync Hex Text input fields
        document.getElementById('fg-color-hex').value = fgColor.toUpperCase();
        document.getElementById('bg-color-hex').value = bgColor.toUpperCase();

        // Label updates
        document.getElementById('size-label').textContent = `${sizeVal} x ${sizeVal} px`;
        document.getElementById('margin-label').textContent = `${marginVal} px`;

        qrCode.update({
          width: sizeVal,
          height: sizeVal,
          data: payload,
          margin: marginVal,
          dotsOptions: {
            color: fgColor,
            type: dotsStyle
          },
          cornersSquareOptions: {
            color: fgColor,
            type: cornersStyle
          },
          backgroundOptions: {
            color: bgColor
          }
        });
      }

      // Event Handlers for Tabs Switch
      const tabButtons = document.querySelectorAll('.tab-btn');
      tabButtons.forEach(btn => {
        btn.addEventListener('click', (e) => {
          const targetType = e.currentTarget.getAttribute('data-type');
          activeType = targetType;

          // Update tab styles
          tabButtons.forEach(b => {
            b.className = 'tab-btn flex flex-col items-center justify-center p-3 rounded-xl text-xs font-medium border border-slate-200 hover:border-slate-300 text-slate-600 transition-all';
          });
          e.currentTarget.className = 'tab-btn flex flex-col items-center justify-center p-3 rounded-xl text-xs font-medium border transition-all bg-indigo-50 border-indigo-200 text-indigo-600';

          // Show active form inputs
          document.querySelectorAll('.input-field-group').forEach(group => {
            group.classList.add('hidden');
          });
          document.getElementById(`field-${targetType}`).classList.remove('hidden');

          updateQRCode();
        });
      });

      // Color pickers sync
      document.getElementById('fg-color').addEventListener('input', updateQRCode);
      document.getElementById('bg-color').addEventListener('input', updateQRCode);

      document.getElementById('fg-color-hex').addEventListener('change', (e) => {
        if (/^#[0-9A-F]{6}$/i.test(e.target.value)) {
          document.getElementById('fg-color').value = e.target.value;
          updateQRCode();
        }
      });

      document.getElementById('bg-color-hex').addEventListener('change', (e) => {
        if (/^#[0-9A-F]{6}$/i.test(e.target.value)) {
          document.getElementById('bg-color').value = e.target.value;
          updateQRCode();
        }
      });

      // Range Sliders and Select Controls
      document.getElementById('qr-size').addEventListener('input', updateQRCode);
      document.getElementById('qr-margin').addEventListener('input', updateQRCode);
      document.getElementById('dots-style').addEventListener('change', updateQRCode);
      document.getElementById('corners-style').addEventListener('change', updateQRCode);

      // Input Field Event Listeners for real-time generation
      const allInputs = document.querySelectorAll('input, textarea, select');
      allInputs.forEach(input => {
        if (input.type !== 'range' && input.type !== 'color') {
          input.addEventListener('input', updateQRCode);
        }
      });

      // Download Action - PNG
      document.getElementById('download-png').addEventListener('click', () => {
        qrCode.download({ name: "qrcode", extension: "png" });
        showToast("PNG Downloaded successfully!");
      });

      // Download Action - SVG
      document.getElementById('download-svg').addEventListener('click', () => {
        qrCode.download({ name: "qrcode", extension: "svg" });
        showToast("SVG Downloaded successfully!");
      });

      // Copy Clipboard Payload Functionality
      document.getElementById('copy-clipboard').addEventListener('click', () => {
        const payload = getPayload();
        
        // Execute fallback copy logic for iframe safety
        const textarea = document.createElement('textarea');
        textarea.value = payload;
        document.body.appendChild(textarea);
        textarea.select();
        try {
          document.execCommand('copy');
          showToast("QR Payload copied to clipboard!");
        } catch (err) {
          showToast("Failed to copy text", true);
        }
        document.body.removeChild(textarea);
      });

      // Initial Call to build QR Code on load
      updateQRCode();
    });
  </script>
</body>
</html>
